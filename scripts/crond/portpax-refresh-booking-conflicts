# PortPax — nightly booking conflict refresh
# Install on the API host:
#   sudo cp scripts/crond/portpax-refresh-booking-conflicts /etc/cron.d/
#   sudo chmod 644 /etc/cron.d/portpax-refresh-booking-conflicts
#
# Format: cron.d requires a user field (git).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

0 0 * * * git cd /home/git/backend && .venv/bin/python manage.py refresh_booking_conflicts >> /home/git/backend/logs/refresh-booking-conflicts.log 2>&1
