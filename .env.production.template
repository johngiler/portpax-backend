# PRODUCTION (ITM AWS) — copy to .env on the API EC2 (not versioned).
# Same key/value JSON can live in Secrets Manager: portpax/prod/app
# Hosts: https://api.portpax.itmgroup.mx  |  frontend https://portpax.itmgroup.mx

DJANGO_SECRET_KEY=
DEBUG=false

ALLOWED_HOSTS=api.portpax.itmgroup.mx
CORS_ALLOWED_ORIGINS=https://portpax.itmgroup.mx
CSRF_TRUSTED_ORIGINS=https://portpax.itmgroup.mx,https://api.portpax.itmgroup.mx

# RDS instance portpax-prod (private). Prefer an app role; leave portpax_admin for DBA only.
# Admin password lives in Secrets Manager: rds!db-6510683f-4d41-453e-aac7-11439e926f11
POSTGRES_DB=portpax
POSTGRES_USER=portpax_app
POSTGRES_PASSWORD=
POSTGRES_HOST=portpax-prod.cw16ssoyu0gq.us-east-1.rds.amazonaws.com
POSTGRES_PORT=5432
# SSL: verify-full + CA outside the repo (default /home/git/certs/rds-global-bundle.pem).
# POSTGRES_SSLROOTCERT=/home/git/certs/rds-global-bundle.pem
# POSTGRES_SSLMODE=verify-full

# S3 app files. Leave AWS keys empty when the EC2 instance role has s3 access.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=itm-portpax-prod-files-040105284691
AWS_S3_REGION_NAME=us-east-1

MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ElastiCache Redis (portpax-prod). Transit encryption enabled → rediss://
# Primary: master.portpax-prod.vmrkok.use1.cache.amazonaws.com:6379
CELERY_BROKER_URL=rediss://master.portpax-prod.vmrkok.use1.cache.amazonaws.com:6379/0
CELERY_RESULT_BACKEND=rediss://master.portpax-prod.vmrkok.use1.cache.amazonaws.com:6379/0

# Same value in frontend .env.production (Daphne app_update broadcast).
FRONTEND_BUILD_PUBLISH_TOKEN=
